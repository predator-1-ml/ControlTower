# Source documents — kept locally, never committed.
# The assignment PDF is footered "Classified as C2 - General Business" on every
# page; this repo is public, so it must not be tracked here. The HLD .docx is
# superseded by docs/plans/ anyway.
*.pdf
*.docx

# Secrets
.env
.env.local
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
.pnpm-store/
npm-debug.log*

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log
# environments/*/terraform.tfvars is committed for dev; never commit prod tfvars
terraform/environments/prod/terraform.tfvars

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
