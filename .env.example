# Copy to .env for local development.  Never commit .env.

# ---------------------------------------------------------------- database
# Local: the compose service.  On ECS this is assembled from Secrets Manager.
DATABASE_URL=postgresql://control_tower:control_tower@localhost:5432/control_tower

# ---------------------------------------------------------------- LLM provider
# "anthropic" for local dev (native async, no AWS gating) | "bedrock" on ECS.
# See ADR-004 in docs/plans/ for why this abstraction exists.
LLM_PROVIDER=anthropic

# Used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Used when LLM_PROVIDER=bedrock.
# ChatBedrockConverse goes through the bedrock-runtime Converse API, which needs
# an INFERENCE PROFILE id, not a bare model id.  The prefix is regional and not
# guessable: in ap-southeast-1 the `apac.` profiles cover only older models, and
# every current model is `global.`-prefixed.  List them before switching region:
#   aws bedrock list-inference-profiles --region <region>
#
# Sonnet 4.6, not Opus 4.8: Opus 4.8 and Sonnet 5 are both "not available for
# this account" on Bedrock here. A fresh AWS account does not get the newest
# models without contacting AWS Sales. Verified by direct invocation.
AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Titan embeddings are not offered in ap-southeast-1; Cohere is. 1024 dims,
# matching the vector(1024) column in migration 0001.
EMBEDDING_MODEL_ID=cohere.embed-english-v3

# Model tiering.  Planner and supervisor are high-frequency structured-output
# calls — this is where token spend concentrates.  Leave equal to the main model
# for maximum quality, or drop to a cheaper tier.  (ADR-004)
PLANNER_MODEL=
SUPERVISOR_MODEL=

# ---------------------------------------------------------------- app
LOG_LEVEL=INFO
APP_ENV=local

# Concurrency — see ADR-004.  ChatBedrockConverse has NO native async; ainvoke/
# astream bridge blocking boto3 onto a thread pool, so a worker thread is held
# for the whole call including a streamed response.  These two must be raised
# TOGETHER or they bottleneck each other.
EXECUTOR_MAX_WORKERS=128
BOTO_MAX_POOL_CONNECTIONS=128

# ---------------------------------------------------------------- frontend
# Server-side only.  Read at runtime during dynamic rendering, so one image
# promotes unchanged across environments.  There is deliberately NO
# NEXT_PUBLIC_API_URL: client components call the relative /bff/* proxy. (ADR-001)
BACKEND_INTERNAL_URL=http://localhost:8000
